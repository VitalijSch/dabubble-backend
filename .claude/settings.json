{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python manage.py check *)",
      "Bash(uv run python manage.py makemigrations *)",
      "Bash(uv run python manage.py showmigrations *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv run python manage.py migrate *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(uv run python manage.py flush *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_file.py"
          }
        ]
      }
    ]
  }
}

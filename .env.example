# Copy to .env for local development. Real environments set these variables directly.
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dabubble
REDIS_URL=redis://localhost:6379/0
DJANGO_ADMIN_URL=admin/

# Frontend (Next.js) base URL — used for links in emails (required in production).
FRONTEND_URL=http://localhost:3000

# Frontend (Next.js) origins — used for CORS, CSRF and WebSocket origin checks.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Version of the privacy policy the frontend shows (stored with each sign-up). Bump on every change.
PRIVACY_POLICY_VERSION=2026-11-27

# Email. Production always sends over SMTP with the DJANGO_EMAIL_* values below.
# Local settings print emails to the console; set DJANGO_LOCAL_SEND_EMAIL=True to send them for
# real. With Gmail: host smtp.gmail.com, port 587, TLS on, username = your Gmail address,
# password = an app password (Google account → Security → App passwords), and
# DJANGO_DEFAULT_FROM_EMAIL must be that same Gmail address.
DJANGO_LOCAL_SEND_EMAIL=False
DJANGO_DEFAULT_FROM_EMAIL=DABubble <noreply@localhost>
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USERNAME=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=True

# Production only: Supabase Storage (S3-compatible API). Local uses ./media.
SUPABASE_STORAGE_BUCKET=
SUPABASE_S3_ENDPOINT_URL=https://<project_ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Production only (optional).
SENTRY_DSN=
DJANGO_SECURE_HSTS_SECONDS=60
DJANGO_LOG_LEVEL=INFO
